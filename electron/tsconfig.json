{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false,
    "allowJs": true,
    "noImplicitAny": false
  },
  "include": [
    "main.ts",
    "capacitor.electron.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "app"
  ]
}
