{
  "name": "filtrador-mar-electron",
  "version": "3.0.0",
  "description": "Filtrador Pro de Hoteles - MAR Caribe (Desktop)",
  "main": "dist/main.js",
  "author": "angelvmar",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "pack": "npm run build && npx capacitor-electron vendor && electron-builder --win nsis",
    "pack:dir": "npm run build && npx capacitor-electron vendor && electron-builder --dir"
  },
  "dependencies": {
    "@capawesome/capacitor-electron": "^0.2.2"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.angelvmar.filtrador",
    "productName": "Filtrador MAR",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "app/**/*",
      "vendor/**/*",
      "node_modules/@capawesome/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Filtrador MAR"
    }
  }
}
